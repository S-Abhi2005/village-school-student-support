# Village School Platform - Backend Environment Configuration
PROJECT_NAME="Village School Digital Learning & Parent-Teacher Platform"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=village_school_db
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/village_school_db

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_64_char_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Village School Settings
SCHOOL_NAME="Govt. Model Primary School, Hosahalli"
SCHOOL_NAME_KN="ಸರ್ಕಾರಿ ಮಾದರಿ ಪ್ರಾಥಮಿಕ ಶಾಲೆ, ಹೊಸಹಳ್ಳಿ"
DEFAULT_LANGUAGE=kn
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
